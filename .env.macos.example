# =========================================================
# Configuracion de Video Translator para macOS (Apple Silicon: M1/M2/M3/M4)
# Copiar como ".env":  cp .env.macos.example .env
#
# Notas para Apple Silicon:
# - CTranslate2 (motor de faster-whisper) NO soporta el GPU de Apple (Metal/MPS),
#   solo corre en CPU. En Apple Silicon usa el framework Accelerate y con
#   compute_type=int8 va razonablemente rapido, incluso con large-v3.
# - Ollama SI aprovecha Metal automaticamente para el LLM (no hay que
#   configurar nada especial). Con equipos de mucha memoria unificada
#   (32GB+) puedes usar modelos LLM mas grandes que en una GPU tipica.
# - Coqui TTS (XTTS v2) es PyTorch puro: tiene soporte parcial de MPS.
#   Se deja en "cpu" por estabilidad; "mps" puede fallar en algunos
#   operadores del modelo.
# =========================================================

# --- Transcripcion ---
# "faster_whisper" (default, CTranslate2): siempre CPU en Mac, nunca GPU.
# "mlx": usa la GPU via el framework MLX de Apple. VALIDADO en un M4 Max con
# un clip real de 3 min: 8.6s vs 136s de faster-whisper en CPU (~16x), sin
# problemas de estabilidad (la primera vez que se usa un modelo MLX se
# descarga de Hugging Face, ~3GB para large-v3 -- cuenta esa descarga aparte
# al comparar tiempos). Requiere instalar el extra:
#   pip install "video-translator[transcription-mlx]"
# (o "uv sync --extra transcription-mlx"). Descomenta las dos lineas de abajo
# para usarlo; el resto de WHISPER_* no aplica con este backend.
WHISPER_BACKEND=faster_whisper
# WHISPER_BACKEND=mlx
# MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
# 0 = auto (usa todos los nucleos). Si tambien usas --diarize, el proyecto
# reserva automaticamente un margen de nucleos para el subprocess de
# diarizacion (corren en paralelo, ambos CPU-bound); no hace falta tocar esto
# a mano salvo que quieras un valor especifico.
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1

# --- Traduccion (LLM open source servido por Ollama, acelerado por Metal) ---
# TRANSLATION_BACKEND selecciona el adaptador: "ollama" o "llama_server"
# (llama.cpp / llama-server, API compatible con OpenAI).
TRANSLATION_BACKEND=ollama

OLLAMA_HOST=http://localhost:11434
# Con 64GB+ de RAM unificada puedes subir de tamano de modelo para mejor calidad:
#   16-32GB RAM  -> qwen2.5:7b-instruct  o  qwen2.5:14b-instruct
#   64GB RAM     -> qwen2.5:32b-instruct
#   128GB RAM    -> qwen2.5:72b-instruct  o  llama3.1:70b-instruct
OLLAMA_MODEL=qwen2.5:32b-instruct
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=180
TRANSLATION_BATCH_MAX_CHARS=1800
TRANSLATION_CONTEXT_WINDOW_SEGMENTS=6

# --- Alternativa: llama-server (llama.cpp) sirviendo un modelo GGUF local ---
# Descomenta y pon TRANSLATION_BACKEND=llama_server si ya tienes un modelo
# corriendo, p.ej.:
#   llama-server -m gpt-oss-20b-mxfp4.gguf --port 8080 -c 8192
# LLAMA_SERVER_HOST=http://localhost:8080
# LLAMA_SERVER_MODEL=gpt-oss-20b-mxfp4
# LLAMA_SERVER_MAX_TOKENS=4096   # subir si ves "Desalineacion en la respuesta del LLM"
                                  # (senal de que la respuesta se corto a mitad de camino)

# --- Sintesis de voz / doblaje (opcional, requerido solo para --mode dubbed) ---
# IndexTTS-2.5 no soporta MPS de forma estable: usa CPU en Mac. Con tu M4 Max
# la generacion de voz corre razonablemente bien (no hace falta GPU para esto).
TTS_BACKEND=index_tts2

INDEX_TTS2_MODEL_DIR=third_party/index-tts/checkpoints
INDEX_TTS2_CFG_PATH=third_party/index-tts/checkpoints/config.yaml
INDEX_TTS2_USE_BF16=false            # bf16 acelera en GPU NVIDIA; en Mac deja false
# vacio = autodetectar. IMPORTANTE: si usas TTS_PARALLEL_WORKERS > 1 (varios
# procesos a la vez), el proyecto fuerza automaticamente "cpu" para los
# workers en macOS, incluso si dejas esto vacio — IndexTTS2 autodetecta y usa
# Metal (MPS) por defecto, y varios PROCESOS tomando Metal al mismo tiempo es
# una combinacion inestable conocida que puede crashear el driver de GPU y
# REINICIAR TU MAC POR COMPLETO (no es un simple error de Python). No fijes
# esto en "mps" con mas de 1 worker salvo que aceptes ese riesgo a proposito.
#
# PROBADO en un M4 Max con un clip real de 3 min: TTS_PARALLEL_WORKERS=1 +
# INDEX_TTS2_DEVICE=mps corrio estable (sin crash), pero fue 3.2x MAS LENTO
# que 6 workers en CPU (1059s vs 328s para los mismos 14 jobs). La GPU
# acelera bastante los pasos s2mel/bigvgan del modelo, pero el paso
# autoregresivo (gpt_gen_time, normalmente el mas caro) fue inconsistente en
# MPS -- a veces igual de lento que CPU. Perder el paralelismo de varios
# workers pesa mas que la ganancia por job. Conclusion: no vale la pena en
# este hardware/modelo, dejar en CPU con varios workers (ver
# TTS_PARALLEL_WORKERS abajo) es mas rapido.
INDEX_TTS2_DEVICE=

# Alternativa Coqui XTTS v2 (Python < 3.12)
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cpu

# --- Rendimiento de la sintesis de voz (doblaje), critico en videos largos ---
# 0 = auto-detectar: hasta un worker por nucleo, tope de 12 (ver
# _AUTO_MAX_TTS_WORKERS en container.py). VALIDADO en un M4 Max (16 nucleos,
# 128GB RAM) con un clip real: mas workers de los que sugeriria "mitad de los
# nucleos" siguio dando mejoras incluso con menos hilos por worker (6 -> 367s,
# 10 -> 342s, 14 (uno por segmento en esa prueba) -> 327s de sintesis). Cada
# worker carga su propia copia del modelo (~4-6GB) -- en maquinas con RAM
# limitada, baja esto explicitamente. En un video con MUCHOS segmentos y RAM
# de sobra, puede convenir subirlo aun mas alla del tope de 12 (probamos
# hasta 14 sin degradacion, un worker por segmento en ese caso).
TTS_PARALLEL_WORKERS=0
TTS_GROUP_SEGMENTS=true
TTS_GROUP_MAX_GAP_SECONDS=0.5
TTS_GROUP_MAX_CHARS=200

# --- Diarizacion de hablantes (opcional, --diarize) ---
# Corre en un venv AISLADO (./scripts/setup_diarization_env.sh), invocado por
# subprocess: pyannote.audio choca de version (protobuf) con IndexTTS-2.5 si
# se instalan en el mismo entorno.
DIARIZATION_PYTHON_BIN=.venv-diarization/bin/python
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cpu
# VALIDADO en un M4 Max con un clip real de 3 min: "mps" corrio estable
# (soporte no oficial de pyannote.audio, pero funciono sin errores) y tomo
# ~10s vs ~166s en CPU (~17x). Es la mejora de mayor impacto/menor riesgo
# encontrada: no requiere cambios de codigo, solo este valor. Si tu modelo o
# version de pyannote.audio difieren, prueba primero de forma aislada (sin
# TTS corriendo a la vez) y compara model_load_seconds/inference_seconds
# (se imprimen en el JSON del worker); revierte a "cpu" si ves cualquier
# error o comportamiento inestable.
# DIARIZATION_DEVICE=mps
HF_TOKEN=                            # crear en hf.co/settings/tokens y aceptar terminos del modelo
GENDER_DETECTION_ENABLED=true
# Ruta a la carpeta "lib" de tu entorno conda-forge con ffmpeg < 8 (ver README,
# seccion "macOS: si ves un error de libtorchcodec"). Ejemplo:
# /opt/homebrew/Caskroom/miniforge/base/envs/ffmpeg-libs/lib
# NO exportes DYLD_LIBRARY_PATH en tu shell: rompe el ffmpeg de Homebrew que
# usa el resto del proyecto. Esta variable se aplica solo al subprocess aislado.
DIARIZATION_DYLD_LIBRARY_PATH=

# --- Medios (instalar con: brew install ffmpeg) ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AUDIO_SAMPLE_RATE=16000

# --- General ---
OUTPUT_DIR=./output
WORKDIR=./.work
LOG_LEVEL=INFO
LOG_JSON=false
